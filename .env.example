# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two plans. STRIPE_MONTHLY_PRICE_ID is the historical
# £300/20-leads price (also usable via STRIPE_PRICE_ID_20). STRIPE_PRICE_ID_10
# is the £150/10-leads price — create it in the Stripe dashboard.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_PRICE_ID_20=
STRIPE_PRICE_ID_10=
# Guaranteed Rent monthly subscription prices. GR is a two-plan product:
# STRIPE_GR_MONTHLY_PRICE_ID is the original £150/mo 10-lead price (the name is
# historical — do not rename it, every deployed environment sets it already).
# STRIPE_GR_PRICE_ID_20 is the £300/mo 20-lead price.
#
# BOTH must be set. These ids are how the Stripe webhook tells a GR event from a
# management one: a GR price id that is missing here makes that subscription
# invisible to the GR branch, so its invoices credit MANAGEMENT leads and its
# cancellation writes management account_status. Set the price id before the
# product is sold, not after.
STRIPE_GR_MONTHLY_PRICE_ID=
STRIPE_GR_PRICE_ID_20=

# --- Post-call discount offer (10% off first month, single-use, 24h) ---
# One-time Stripe setup (see README §"Post-call discount"):
#   1. Create ONE Coupon: percent_off=10, duration=once, currency=gbp,
#      name="Post-call 10%". Put its id here. The coupon may apply to both
#      Management products, but must NOT be a single-redemption coupon
#      (max_redemptions is set on each promotion CODE, not the coupon) and must
#      work on either Management Payment Link — one code, either link.
STRIPE_POST_CALL_COUPON_ID=
#   2. Enable "Allow promotion codes" on BOTH existing Management Payment Links
#      (Stripe dashboard, or payment_links.update(id,{allow_promotion_codes:true})).
#   3. Store both link base URLs here. The offer route appends
#      ?prefilled_promo_code=<code> to whichever the caller sends.
STRIPE_MANAGEMENT_10_PAYMENT_LINK_URL=https://buy.stripe.com/5kQdR8bzM6Ha5fh48P4Ja01
STRIPE_MANAGEMENT_20_PAYMENT_LINK_URL=https://buy.stripe.com/eVq14m8nA4z29vx20H4Ja00

# Monday.com
MONDAY_API_TOKEN=
MONDAY_LEAD_BOARD_ID=18420117742
# Guaranteed Rent leads board.
MONDAY_GR_LEAD_BOARD_ID=18396542480
# Optional: restrict GR sync to a single status label. Leave unset to send all
# GR leads (the default).
MONDAY_GR_SELLABLE_STATUS=
# Board the landing-page enquiry form writes contacts to. Also the board the
# subscription-status sync writes the Status column on (see CLAUDE.md §23) — the
# API token needs WRITE access to it, not just read.
MONDAY_ENQUIRY_BOARD_ID=18420649520
# Guaranteed Rent enquiries board. Has no Status column, so nothing is ever
# written back to it (§23.7).
MONDAY_GR_ENQUIRY_BOARD_ID=18420913271

# n8n
N8N_WEBHOOK_SECRET=

# Twilio — instant new-lead SMS alerts. Leave the sender vars unset to disable
# SMS entirely (the send path is a no-op until a sender is configured).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set ONE sender: a Messaging Service SID (recommended — handles sender pool,
# opt-out, retries) OR a single Twilio number / alphanumeric sender ID. Note:
# alphanumeric sender IDs cannot receive replies, so STOP opt-out needs a real
# long-code/short-code number or a Messaging Service.
# The same sender is reused for post-call offer reminder SMS.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=zac@stayful.co.uk

# App
# Public base URL of the customer portal. Used to build login/portal links in
# customer emails and SMS. Defaults to https://leads.stayful.co.uk when unset.
NEXT_PUBLIC_APP_URL=https://leads.stayful.co.uk
ADMIN_SECRET_KEY=

# Owner override: comma-separated emails that skip the Stripe payment wall at
# signup and are provisioned as active, admin-level accounts.
# Defaults to zac@stayful.co.uk when unset.
OWNER_EMAILS=zac@stayful.co.uk

# Secret bearer token the Monday sync cron uses to authorise itself. Vercel Cron
# automatically sends "Authorization: Bearer $CRON_SECRET" when this is set.
CRON_SECRET=

# How many days a lead may sit untouched (status unchanged, no note) before the
# stale-lead nudge (/api/cron/inactivity-nudge) flags it as waiting for
# follow-up. Optional — defaults to 2 days (the historical 48h) when unset.
STALE_LEAD_THRESHOLD_DAYS=

# Claude API key, used ONLY to work out what the columns of a customer-uploaded
# spreadsheet mean (§30). Entirely optional: without it the importer falls back
# to its own header/content heuristics, and the customer confirms the mapping
# either way, so the feature works with this unset — it just guesses less well
# on a messy file. Note that enabling it sends up to 20 rows of the uploaded
# spreadsheet (real landlord names, emails and phone numbers) to the Anthropic
# API for that one call.
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────
# Paid lead analysis (£3/lead)
#
# Where the Stayful property analyser lives, and the secret it expects.
# ANALYSER_INTERNAL_SECRET must equal INTERNAL_API_SECRET on that app —
# if either side is unset the endpoint returns 404 and the queue simply
# does not drain, which is the safe direction (nothing is charged for
# work that cannot happen).
# ──────────────────────────────────────────────────────────────
ANALYSER_API_URL=https://intelligence.stayful.co.uk
ANALYSER_INTERNAL_SECRET=

# Rows analysed at once across ALL workers. This is the spend-rate
# throttle, not a latency knob: every in-flight row is an external
# report we pay for. Default 3.
ANALYSIS_MAX_INFLIGHT=

# How long one property may take before we give up on it and retry.
# A row is 20-30s typically and ~70s at worst. Default 90000.
ANALYSIS_ROW_TIMEOUT_MS=
