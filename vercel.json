{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "vitest run && next build",
  "crons": [
    {
      "path": "/api/monday/sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/monday/sync-gr",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/generate-public-stats",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/capture-leaderboard",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/monthly-insights",
      "schedule": "30 9 2 * *"
    },
    {
      "path": "/api/cron/inactivity-nudge",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/progress-report",
      "schedule": "0 16 * * 5"
    },
    {
      "path": "/api/cron/resume-paused-subscriptions",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sweep-lead-pool",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/escalate-leads",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/parse-income-reports",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/run-lead-analysis",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/poll-whatsapp-status",
      "schedule": "*/5 * * * *"
    }
  ]
}
